# ============================================
# NRB Vidyalaya LMS - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# NEVER put backend secrets in frontend .env files.

# ============================================
# FRONTEND (VITE_ prefix = exposed to browser)
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_BASE_URL=http://localhost:4000/api

# ============================================
# BACKEND (server-side only)
# ============================================

# Server
PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# CORS (comma-separated origins for production, e.g. "https://app.example.com,https://www.example.com")
ALLOWED_ORIGINS=

# OpenAI (required for AI features: question generation, Hindi tutor, grammar correction)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Database (NOT currently used by backend — safe to omit)
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
