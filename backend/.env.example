# Backend Environment Variables
# ──────────────────────────────────────────────────────────
# The backend reads from project-root .env (../../../.env from this file).
# For Render deployment, set these in the Render dashboard.
# ──────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Supabase (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# CORS (REQUIRED for production — comma-separated frontend URLs)
# Example: https://my-app.onrender.com,https://www.my-app.onrender.com
ALLOWED_ORIGINS=

# OpenAI (optional — AI features fail gracefully without it)
OPENAI_API_KEY=

# ── NOT CURRENTLY USED ───────────────────────────────────
# DATABASE_URL is defined in config but never referenced
# by any backend source code. Safe to omit.
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
