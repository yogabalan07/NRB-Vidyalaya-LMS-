{
  "name": "nrb-vidyalaya-lms",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered Hindi Language Learning Management System for NRB Vidyalaya",
  "scripts": {
    "dev": "pnpm --filter nrb-vidyalaya-frontend dev",
    "dev:backend": "pnpm --filter nrb-vidyalaya-backend dev",
    "dev:all": "pnpm run --parallel dev dev:backend",
    "build": "pnpm --filter nrb-vidyalaya-frontend build",
    "build:backend": "pnpm --filter nrb-vidyalaya-backend build",
    "typecheck": "pnpm -r typecheck",
    "typecheck:frontend": "pnpm --filter nrb-vidyalaya-frontend typecheck",
    "typecheck:backend": "pnpm --filter nrb-vidyalaya-backend typecheck",
    "lint": "pnpm -r lint",
    "lint:frontend": "pnpm --filter nrb-vidyalaya-frontend lint",
    "lint:backend": "pnpm --filter nrb-vidyalaya-backend lint",
    "test": "pnpm -r test",
    "test:frontend": "pnpm --filter nrb-vidyalaya-frontend test",
    "test:backend": "pnpm --filter nrb-vidyalaya-backend test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.23.0"
}
