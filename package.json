{
  "name": "nrb-vidyalaya-lms",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered Hindi Language Learning Management System for NRB Vidyalaya",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:all": "pnpm run --parallel dev dev:backend",
    "build": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "typecheck": "pnpm -r typecheck",
    "typecheck:frontend": "pnpm --filter frontend typecheck",
    "typecheck:backend": "pnpm --filter backend typecheck",
    "lint": "pnpm -r lint",
    "lint:frontend": "pnpm --filter frontend lint",
    "lint:backend": "pnpm --filter backend lint",
    "test": "pnpm -r test",
    "test:frontend": "pnpm --filter frontend test",
    "test:backend": "pnpm --filter backend test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}
